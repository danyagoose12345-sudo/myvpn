name: Build EXE
on: [push, workflow_dispatch]
jobs:
  build:
    runs-on: windows-latest
    steps:
    - uses: actions/checkout@v4
    - uses: actions/setup-go@v5
      with:
        go-version: '1.22'
    - name: Build
      run: |
        go mod init vpnapp
        go get fyne.io/fyne/v2
        go build -ldflags="-H windowsgui" -o vpn_multiplayer.exe main.go
    - name: Upload Artifact
      uses: actions/upload-artifact@v4
      with:
        name: VPN_Program_Win10
        path: vpn_multiplayer.exe
